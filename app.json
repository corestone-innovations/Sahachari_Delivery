{
  "expo": {
    "name": "Sahachari Delivery",
    "slug": "sahacharidelivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "delivery",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.corestoneinnovations.sahacharidelivery",
      "buildNumber": "1",
      "appleTeamId": "C6Z3P6492T",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "UIRequiresFullScreen": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select and upload delivery proof images.",
        "NSPhotoLibraryAddUsageDescription": "This app needs access to save delivery receipts and images to your photo library.",
        "NSCameraUsageDescription": "This app needs access to your camera to take photos of delivery proof and scan QR codes.",
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to optimize delivery routes and show real-time navigation to delivery addresses.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app uses location services to provide live tracking updates for delivery orders.",
        "NSMicrophoneUsageDescription": "This app plays audio alerts and notifications for incoming delivery orders.",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "splash": {
      "image": "./assets/images/splashscreen.png",
      "resizeMode": "contain",
      "backgroundColor": "#E8F5E9"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#E8F5E9"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "splash": {
        "image": "./assets/images/splashscreen.png",
        "resizeMode": "cover",
        "backgroundColor": "#E8F5E9"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.corestoneinnovations.sahacharidelivery"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splashscreen.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E8F5E9",
          "dark": {
            "backgroundColor": "#E8F5E9"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to upload delivery proof and profile pictures.",
          "cameraPermission": "The app needs access to your camera to take photos of delivery proof and scan QR codes."
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "635aaaaa-831b-48f6-9d55-755be46bf12f"
      }
    }
  }
}